# Shared secret you set on the GitHub webhook (any random string).
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Slack Incoming Webhook URL for the channel you want notifications in.
# Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Optional: port to listen on (default 3000)
PORT=3000
