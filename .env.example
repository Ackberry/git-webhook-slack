# Shared secret you set on the GitHub webhook (any random string).
# Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Slack Incoming Webhook URL for the channel you want notifications in.
# Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Optional: port to listen on (default 3000)
PORT=3000

# --- Polling (for repos you DON'T own, where you can't add a webhook) ---

# Comma-separated repos to poll for new issues, e.g.:
# POLL_REPOS=GoogleCloudPlatform/kubectl-ai,kubernetes/kubernetes
POLL_REPOS=

# How often to poll, in seconds (default 300 = 5 minutes).
POLL_INTERVAL_SECONDS=300

# GitHub token to raise the API rate limit from 60/hr to 5,000/hr.
# Strongly recommended. A fine-grained token with public read access is enough.
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=
